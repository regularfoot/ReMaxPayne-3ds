.fvec projection[4]
.constf ones(1.0,1.0,1.0,1.0)
.constf byteScale(0.0039215686,0.0039215686,0.0039215686,0.0039215686)
.out outpos position
.out outclr color
.out outuv texcoord0
.out outlight texcoord1
.alias pos v0
.alias uv v1
.alias light v2
.proc main
    mov r0.xyz, pos.xyz
    mov r0.w, ones.xxxx
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0
    mul outclr, byteScale, light
    mov outuv, uv
    mov outlight, light
    end
.end
